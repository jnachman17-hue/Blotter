# Blotter environment.
#
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# gitignored and must never be committed. This file, with empty values, is
# committed so the next person knows what is required.
#
# Restart the dev server after changing any of these. Next reads env files at
# boot, not per request.

# ---------------------------------------------------------------- Supabase
# Lead storage. Project Settings -> Data API, and Project Settings -> API keys.
#
# Region must be United States. `/privacy` states that information is stored
# and processed in the United States and that we do not transfer it elsewhere,
# so a non-US region would make a published claim false.

# Looks like https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The `service_role` key. SECRET. It bypasses row-level security.
# It is read only in `app/api/lead/route.ts`, which runs on the server.
# It must never be given a NEXT_PUBLIC_ prefix and must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- PostHog
# Analytics. Project Settings -> Project API key.
#
# Use PostHog US Cloud, for the same reason as the Supabase region above.

# Project API key, looks like phc_xxxxxxxx. Safe to expose: it is write-only
# ingestion and is visible in the browser by design.
NEXT_PUBLIC_POSTHOG_KEY=

# https://us.i.posthog.com for US Cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------ PostHog, read/admin API
# Not needed to run the site. Used to query analytics from a session — counts,
# person timelines, funnel numbers — which the dashboard cannot do precisely.
#
# PostHog -> Settings -> Personal API keys. Read scopes plus dashboard:write.
# `insight:write` and `person:write` were requested and have not registered.
POSTHOG_PERSONAL_API_KEY=

# The bare number from the project URL, e.g. 546166. Not the phc_ key.
POSTHOG_PROJECT_ID=
